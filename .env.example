APP_ENV=local
DJANGO_SECRET_KEY=local-only-change-me
CANONICAL_ORIGIN=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgresql://enter:enter@postgres:5432/enter
DATABASE_REQUIRE_TLS=false
VALKEY_URL=redis://valkey:6379/0
AWS_REGION=ap-south-1
ALLOWED_AWS_REGIONS=ap-south-1,ap-south-2
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/local
# Hosted login domain; distinct from the user-pool token issuer above.
COGNITO_DOMAIN=https://example.invalid
COGNITO_CLIENT_ID=local-client
COGNITO_CLIENT_SECRET=local-secret
COGNITO_CALLBACK_URL=http://localhost:8000/api/v1/auth/callback
EMAIL_LOOKUP_KEY=local-email-hmac-key-change-me
FIELD_ENCRYPTION_KEYS=v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AUDIT_CHECKPOINT_REQUIRED=false
WHATSAPP_ENABLED=false

# Reviewed React pages for local development; production rollout remains separate.
FRONTEND_REACT_ROUTES=platform-chooser,public-jobs-page,public-role-page,recruiter-search-page,recruiter-results-page,criteria-review-page,recruiter-candidate-management-page,recruiter-comparison-page,candidate-profile-page,candidate-progress-page,candidate-rights-page,recruiter-organization-page,admin-jobs-page,tenant-governance-page
