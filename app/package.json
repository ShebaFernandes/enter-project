{
  "name": "enter-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "npm run build:legacy && npm run build:react",
    "build:all": "npm run build:legacy && npm run build:wip && npm run build:showcase && npm run build:react",
    "build:legacy": "vite build",
    "build:wip": "vite build --mode wip",
    "build:react": "vite build --mode react",
    "build:showcase": "vite build --mode showcase",
    "check": "tsc --noEmit && eslint . && prettier --check frontend tests/browser *.config.js *.config.ts package.json tsconfig.json",
    "format": "prettier --write frontend tests/browser *.config.js *.config.ts package.json tsconfig.json",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "24.7.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
